# === Credentials — never commit real ones ===
config.php
.env
*.key
*.pem

# === Dataset — too large for GitHub; link it in ai/README.md instead ===
dataset/
*.jpg
*.jpeg
*.png
*.bmp
*.zip
# ...but keep committed diagrams/photos, which live next to what they document:
!assets/**/*.png
!hardware/**/*.png
!dashboard/**/*.png

# === Trained models — large binaries; link them if over ~100MB ===
# classes.json is written by the same training run as the weights and describes only that
# model. Committing it leaves a copy in git that can drift from weights nobody has.
ai/models/classes.json
*.h5
*.keras
*.tflite
*.weights
*.pt

# === Python / Colab ===
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/

# === Editor & OS junk ===
.vscode/
.idea/
.DS_Store
Thumbs.db

# === Frontend build output ===
node_modules/
dist/

# === Obsidian workspace (this context folder is an Obsidian vault) ===
.obsidian/

# === Internal working notes — NOT deliverables; keep them out of the repo ===
context.md
gaps.md
recommendations.md
schema-review.md
schema-update.md
questions.md
github-repo-setup.md
pinned.md
dashboard-vocabulary.md

# === Research paper / academic docs — repo stays CODE-ONLY; the paper is handled at the defense ===
*.pdf

# === docs/ is local-only (dropped from the repo 2026-08-01) ===
# The consultant's ruling: the GitHub repo stays code; documentation is handled at the defense.
# Everything in docs/ was already either a working note or a PDF, and the one file that was really
# a spec — the PNS/BAFS size grades the `size_grades` table implements — moved to database/.
# Committed images now live beside what they document (assets/, hardware/, dashboard/).
docs/
