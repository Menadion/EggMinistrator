# === Credentials — never commit real ones ===
config.php
.env
.env.*
!.env.example
*.key
*.pem

# === Dataset — too large for GitHub; link it in ai/README.md instead ===
# Ignore what is INSIDE a dataset folder, but not the folders themselves, so that the
# split + class folders can be committed via .gitkeep. Anyone who clones then gets the
# correct folder names and cannot typo a class name (the folder name IS the class string).
# Order matters here: the last matching rule wins, so the negations must come last.
#
# TWO levels of directory negation since 2026-08-23: the layout is now
# ai/dataset/<split>/<class>/, so git must be allowed to descend through the split folder
# before it can see the class folder underneath. Negating only one level leaves all twelve
# .gitkeep files invisible and a fresh clone gets no dataset tree at all.
dataset/**
!ai/dataset/*/
!ai/dataset/*/*/
!ai/dataset/*/*/.gitkeep
*.jpg
*.jpeg
*.png
*.bmp
*.zip
# ...but keep committed diagrams/photos, which live next to what they document:
!assets/**/*.png
!hardware/**/*.png
!dashboard/**/*.png

# === Per-machine capture rig state ===
# capture.py writes the camera index, framing, pan and focus it was left on so the next
# session opens the same way. It describes ONE physical rig -- committing it would push
# J's camera index and focus value onto M's laptop and silently re-frame the dataset.
ai/capture_settings.json

# === Trained models — large binaries; link them if over ~100MB ===
# classes.json is written by the same training run as the weights and describes only that
# model. Committing it leaves a copy in git that can drift from weights nobody has.
ai/models/classes.json
ai/models/version.json
*.h5
*.keras
*.tflite
*.weights
*.pt

# === Python / Colab ===
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/

# === Editor & OS junk ===
.vscode/
.idea/
.DS_Store
Thumbs.db

# === Frontend build output ===
node_modules/
dist/

# === Obsidian workspace (this context folder is an Obsidian vault) ===
.obsidian/

# === Internal working notes — NOT deliverables; keep them out of the repo ===
context.md
gaps.md
recommendations.md
schema-review.md
schema-update.md
questions.md
github-repo-setup.md
pinned.md
dashboard-vocabulary.md

# === Research paper / academic docs — repo stays CODE-ONLY; the paper is handled at the defense ===
*.pdf

# === docs/ is local-only (dropped from the repo 2026-08-01) ===
# The consultant's ruling: the GitHub repo stays code; documentation is handled at the defense.
# Everything in docs/ was already either a working note or a PDF, and the one file that was really
# a spec — the PNS/BAFS size grades the `size_grades` table implements — moved to database/.
# Committed images now live beside what they document (assets/, hardware/, dashboard/).
docs/

# === Firmware credentials (section 6: never commit secrets) ===
# An Arduino sketch has no .env, so secrets.h is the equivalent: Wi-Fi password, the
# server's LAN IP, and the device key. secrets.h.example is committed with placeholders and is
# the file you copy from.
# Matched at any depth under firmware/ -- the sketch moved into its own folder on
# 2026-08-20 and secrets.h moved with it, so a path-specific rule would have gone stale.
firmware/**/secrets.h
firmware/secrets.h

# Local agent tooling (impeccable skills) - not part of the project
.claude/
