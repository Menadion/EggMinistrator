// Copy this file to secrets.h and fill in the real values.
//
//     firmware/secrets.h.example   <- committed, placeholders only (this file)
//     firmware/secrets.h           <- yours, gitignored, never committed
//
// CONTRACT.md section 6: never commit credentials. An Arduino sketch has no
// .env, so this header is the equivalent. If you ever see secrets.h show up
// in `git status`, stop and tell M -- the .gitignore entry is missing.

#pragma once

// Your Wi-Fi network. The board and the server must be on the SAME network.
#define WIFI_SSID      "your-wifi-name"
#define WIFI_PASSWORD  "your-wifi-password"

// The LAN IP of the machine running the server -- NOT the ESP32's own IP.
// Find it with `ipconfig` on Windows (IPv4 Address) or `ip addr` on Linux.
// This changes when you move to a different network, which is the single
// most common reason the board stops working after it worked yesterday.
#define SERVER_HOST    "192.168.1.100"
#define SERVER_PORT    3001   // the Node backend's port. stub_server.py uses it too,
                              // so you can swap stub <-> real backend without reflashing.

// Shared key so the server knows this request came from the station and not
// from a browser. The board cannot log in as a user. Must match the value in
// backend/.env -- see CONTRACT.md section 4.1.
#define DEVICE_KEY     "replace-me"
